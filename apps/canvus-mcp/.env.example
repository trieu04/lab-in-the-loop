# ── Canvus SDK (required) ────────────────────────────────────────────────
# The pre-configured Canvus server the MCP tools operate against.
CANVUS_API_URL=https://your-canvus-server.example/api/v1
CANVUS_API_KEY=your-long-lived-api-token

# Verify the server's TLS certificate. Set false for self-signed dev certs.
CANVUS_VERIFY_SSL=true

# ── MCP server runtime (CANVUS_MCP_ prefix) ──────────────────────────────
# Directory where downloaded content (pdf/image/video bytes) is written.
CANVUS_MCP_OUTPUT_DIR=./downloads

# Streamable-HTTP transport bind address.
CANVUS_MCP_HOST=127.0.0.1
CANVUS_MCP_PORT=8931

# Local-only resumable ingestion state. Both paths are ignored by git.
CANVUS_MCP_INGESTION_DB_PATH=./.state/ingestion.db
CANVUS_MCP_INGESTION_CACHE_DIR=./.state/ingestion-cache
CANVUS_MCP_INGESTION_WORKER_CONCURRENCY=2
CANVUS_MCP_INGESTION_LEASE_SECONDS=60
CANVUS_MCP_INGESTION_MAX_ATTEMPTS=3
CANVUS_MCP_INGESTION_MAX_SOURCE_BYTES=10485760
# Output chunks are bounded further by each caller's requested max_chars.
CANVUS_MCP_INGESTION_CHUNK_CHAR_CAP=8000
# Optional local file containing a PDF password; keep it outside the repository.
# CANVUS_MCP_INGESTION_PDF_PASSWORD_FILE=/run/secrets/ingestion-pdf-password

# Static roles for authenticated ingestion reads and canvas mutations. Leave
# tokens blank until provisioned; never put real credentials in this file.
CANVUS_MCP_READER_TOKEN=
CANVUS_MCP_TRUSTED_SERVICE_TOKEN=
CANVUS_MCP_OPERATOR_TOKEN=
# Each scope is JSON; use ["*"] only for an explicitly trusted local role.
CANVUS_MCP_READER_CANVASES=[]
CANVUS_MCP_TRUSTED_SERVICE_CANVASES=[]
CANVUS_MCP_OPERATOR_CANVASES=[]
# Stdio is read-only by default and receives only its configured canvas scope.
CANVUS_MCP_STDIO_ROLE=reader
CANVUS_MCP_STDIO_CANVASES=[]
# Operator-owned JSON map. Leave the safe default empty.
CANVUS_CANVAS_CLASSIFICATIONS={}
# Exact key must equal the lab-agent --canvas value; valid classes: public, internal, restricted.
# CANVUS_CANVAS_CLASSIFICATIONS={"<exact-canvas-id>":"internal"}
# Unmapped, malformed, or unsupported values become unknown and deny before provider dispatch.

# Marker prefix that identifies a "RagCluster" Image widget by its title.
CANVUS_MCP_RAGCLUSTER_MARKER=RAGCluster_
