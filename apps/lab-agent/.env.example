# Lab Agent environment template.
# This file is deliberately non-dispatchable until approved endpoint, locality,
# credential, and pricing values are configured. There is no governance bypass.

# ── 1. Mandatory safety and governed-dispatch gates ──────────────────────────

# Every once/watch model call uses the governed gateway. Empty routing considers
# LAB_AGENT_MODEL_PROVIDER first; it does not disable governance.
LAB_AGENT_MODEL_PROVIDER=openai
LAB_AGENT_ROUTING_TABLE={}

# Provider credentials and model ids. Configure only approved providers.
LAB_AGENT_OPENAI_API_KEY=
LAB_AGENT_OPENAI_MODEL=gpt-4o-mini
LAB_AGENT_ANTHROPIC_API_KEY=
LAB_AGENT_ANTHROPIC_MODEL=claude-sonnet-4-5

# Authorization controls: missing endpoints, provider mappings, or source
# classifications deny dispatch. Endpoints must be HTTPS. The endpoint in
# LAB_AGENT_PROVIDER_ENDPOINTS is authoritative for the provider SDK.
# OpenAI-compatible local deployments therefore need an HTTPS endpoint or TLS
# proxy; LAB_AGENT_OPENAI_BASE_URL must identify the same approved deployment.
LAB_AGENT_OPENAI_BASE_URL=
LAB_AGENT_PROVIDER_ENDPOINTS={"openai":"https://api.openai.com/v1","claude":"https://api.anthropic.com"}
LAB_AGENT_PROVIDER_DATA_CLASSIFICATIONS={"openai":["public","internal"],"claude":["public","internal"]}

# Versioned pricing is mandatory even when all numeric cost budgets are omitted.
# Each configured model requires finite, nonnegative input_per_1k and
# output_per_1k rates. Estimates support governance; they are not invoices.
# The unset version is a placeholder. The empty table below intentionally blocks governed model dispatch.
LAB_AGENT_PRICING_VERSION=unset
LAB_AGENT_MODEL_PRICING={}

# Bounded data/tool boundaries remain mandatory safety controls.
LAB_AGENT_MCP_RESULT_MAX_DEPTH=8
LAB_AGENT_MCP_RESULT_MAX_CONTAINERS=256
LAB_AGENT_MCP_RESULT_MAX_STRING_CHARS=8192
LAB_AGENT_MCP_RESULT_MAX_BYTES=32768
LAB_AGENT_MCP_RESULT_MAX_ITEMS=256
LAB_AGENT_MCP_ARGUMENT_MAX_BYTES=32768
LAB_AGENT_MCP_ARGUMENT_MAX_ITEMS=256
LAB_AGENT_MODEL_TOOL_CALLS_PER_TURN=8
LAB_AGENT_MODEL_TOOL_CALLS_PER_RUN=32
LAB_AGENT_MODEL_TRANSCRIPT_MAX_BYTES=262144
LAB_AGENT_MODEL_EVIDENCE_MAX_BYTES=131072
LAB_AGENT_MODEL_EVIDENCE_MAX_ITEMS=64
LAB_AGENT_MODEL_MAX_OUTPUT_TOKENS=4096

# ── 2. Core runtime ──────────────────────────────────────────────────────────

# canvus-mcp streamable-HTTP endpoint and namespace.
LAB_AGENT_MCP_URL=http://127.0.0.1:8931/mcp
LAB_AGENT_MCP_SERVER_NAMESPACE=canvus
# Optional only for legacy anonymous reads. Authenticated orchestrator writes
# require an appropriately scoped trusted-service credential.
LAB_AGENT_MCP_BEARER_TOKEN=

# Process tenant/canvas scope. For production, use a named tenant and explicit
# allowlist. The default tenant with [] is legacy/unbound development behavior.
LAB_AGENT_TENANT_ID=default
LAB_AGENT_CREDENTIAL_DOMAIN=default.local
LAB_AGENT_ALLOWED_CANVAS_IDS=[]
LAB_AGENT_WATCH_MAX_CONCURRENT_CANVASES=1

# Agent loop and polling behavior.
LAB_AGENT_MAX_TOOL_STEPS=8
LAB_AGENT_WATCH_POLL_SECONDS=30
LAB_AGENT_LOOP_MAX_ROUNDS=25
# May defer an early model STOP, but never overrides governance backstops.
LAB_AGENT_LOOP_MIN_ROUNDS=2

# Durable single-host SQLite/WAL workflow ledger, leases, and retries.
LAB_AGENT_STATE_DB_PATH=.state/lab_agent.db
LAB_AGENT_CANVAS_LEASE_TTL_SECONDS=180
LAB_AGENT_ATTEMPT_LEASE_TTL_SECONDS=600
LAB_AGENT_RETRY_BASE_SECONDS=5
LAB_AGENT_RETRY_MAX_SECONDS=300
LAB_AGENT_MAX_ATTEMPTS=5

# Generated Browser artifact service. Browser writes fail closed without a
# client-reachable public base URL. Production URLs must use approved HTTPS.
LAB_AGENT_ARTIFACT_BIND_HOST=127.0.0.1
LAB_AGENT_ARTIFACT_BIND_PORT=8600
LAB_AGENT_ARTIFACT_PUBLIC_BASE_URL=

# ── 3. Optional limits and policy tuning ─────────────────────────────────────

# Omitted numeric budgets mean no ceiling for that dimension; they never bypass
# mandatory locality, endpoint, pricing, intent, or reservation checks.
# LAB_AGENT_RUN_TOKEN_BUDGET=200000
# LAB_AGENT_RUN_COST_BUDGET_USD=5.0
# LAB_AGENT_CANVAS_TOKEN_BUDGET=1000000
# LAB_AGENT_CANVAS_COST_BUDGET_USD=25.0
# LAB_AGENT_WALL_TIME_BUDGET_SECONDS=3600
LAB_AGENT_NO_PROGRESS_ROUNDS=3
LAB_AGENT_MODEL_CALL_MAX_ATTEMPTS=3

# ── 4. Optional extensions ───────────────────────────────────────────────────

# Deterministic structural dry-run validation (not scientific simulation or
# measured evidence). false skips only new validation scheduling; existing
# validation/approval evidence remains durable and independently governed.
LAB_AGENT_IN_SILICO_VALIDATION_ENABLED=true

# Legacy model-generated MOCK_RESULT execution. This never selects real lab hardware.
LAB_AGENT_WET_LAB_EXECUTION_ENABLED=false

# Phase 8 deterministic lifecycle is default-off and currently supports dry_run
# only. sandbox/real selections fail closed.
LAB_AGENT_PHASE8_EXECUTION_ENABLED=false
LAB_AGENT_PHASE8_EXECUTION_MODE=dry_run

# Terminal SMTP notifications stay disabled unless the complete TLS policy is set.
LAB_AGENT_NOTIFICATION_SMTP__ENABLED=false
# LAB_AGENT_NOTIFICATION_SMTP__HOST=smtp.example.test
# LAB_AGENT_NOTIFICATION_SMTP__PORT=587
# LAB_AGENT_NOTIFICATION_SMTP__SECURITY=starttls
# LAB_AGENT_NOTIFICATION_SMTP__USERNAME=mailer
# LAB_AGENT_NOTIFICATION_SMTP__PASSWORD=
# LAB_AGENT_NOTIFICATION_SMTP__SENDER=lab-agent@example.test
# LAB_AGENT_NOTIFICATION_SMTP__RECIPIENTS=["operator@example.test"]
# LAB_AGENT_NOTIFICATION_SMTP__SENDER_ALLOWLIST=["lab-agent@example.test"]
# LAB_AGENT_NOTIFICATION_SMTP__RECIPIENT_ALLOWLIST=["operator@example.test"]
# LAB_AGENT_NOTIFICATION_SMTP__TIMEOUT_SECONDS=10
LAB_AGENT_NOTIFICATION_LEASE_TTL_SECONDS=60
LAB_AGENT_NOTIFICATION_RECONCILIATION_SECONDS=3600
LAB_AGENT_NOTIFICATION_BATCH_SIZE=1
