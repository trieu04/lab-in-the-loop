# canvus-mcp streamable-HTTP endpoint the agent drives.
LAB_AGENT_MCP_URL=http://127.0.0.1:8931/mcp

# Which model provider the agent uses: "openai" or "claude".
LAB_AGENT_MODEL_PROVIDER=openai

# OpenAI (used when LAB_AGENT_MODEL_PROVIDER=openai).
LAB_AGENT_OPENAI_API_KEY=
LAB_AGENT_OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible base URL (Ollama, vLLM, Azure, ...).
LAB_AGENT_OPENAI_BASE_URL=

# Anthropic / Claude (used when LAB_AGENT_MODEL_PROVIDER=claude).
LAB_AGENT_ANTHROPIC_API_KEY=
LAB_AGENT_ANTHROPIC_MODEL=claude-sonnet-4-5

# Agent runtime bounds.
LAB_AGENT_MAX_TOOL_STEPS=8
LAB_AGENT_WATCH_POLL_SECONDS=30
# Safety backstop only; the model's LoopDecision is the real stop condition.
LAB_AGENT_LOOP_MAX_ROUNDS=25
