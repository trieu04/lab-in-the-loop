# canvus-mcp streamable-HTTP endpoint the agent drives.
LAB_AGENT_MCP_URL=http://127.0.0.1:8931/mcp

# Which model provider the agent uses: "openai" or "claude".
LAB_AGENT_MODEL_PROVIDER=openai

# OpenAI (used when LAB_AGENT_MODEL_PROVIDER=openai).
LAB_AGENT_OPENAI_API_KEY=
LAB_AGENT_OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible base URL (Ollama, vLLM, Azure, ...).
LAB_AGENT_OPENAI_BASE_URL=

# Anthropic / Claude (used when LAB_AGENT_MODEL_PROVIDER=claude).
LAB_AGENT_ANTHROPIC_API_KEY=
LAB_AGENT_ANTHROPIC_MODEL=claude-sonnet-4-5

# Agent runtime bounds.
LAB_AGENT_MAX_TOOL_STEPS=8
LAB_AGENT_WATCH_POLL_SECONDS=30
# Safety backstop only; the model's LoopDecision is the real stop condition.
LAB_AGENT_LOOP_MAX_ROUNDS=25

# ── Governance: task-stage routing (JSON: stage -> ordered provider list). ──
# A stage absent here falls back to LAB_AGENT_MODEL_PROVIDER. Leave empty for
# single-provider operation.
LAB_AGENT_ROUTING_TABLE={}

# Data-locality policy. Approved endpoints are also the endpoints passed to the
# provider SDKs; custom OpenAI-compatible deployments must use the same URL here
# and in LAB_AGENT_OPENAI_BASE_URL. Missing endpoints or classifications deny
# dispatch (fail closed).
LAB_AGENT_PROVIDER_ENDPOINTS={"openai":"https://api.openai.com/v1","claude":"https://api.anthropic.com"}
LAB_AGENT_PROVIDER_DATA_CLASSIFICATIONS={"openai":["public","internal"],"claude":["public","internal"]}

# Per-run / per-canvas resource budgets. Unset (commented) = unbounded; an
# empty string does NOT parse -- set an integer/number or leave commented.
# LAB_AGENT_RUN_TOKEN_BUDGET=200000
# LAB_AGENT_RUN_COST_BUDGET_USD=5.0
# LAB_AGENT_CANVAS_TOKEN_BUDGET=1000000
# LAB_AGENT_CANVAS_COST_BUDGET_USD=25.0

# Pricing for cost estimates (versioned; estimates are labelled, never billed).
# JSON: model id -> {"input_per_1k": float, "output_per_1k": float}.
LAB_AGENT_PRICING_VERSION=unset
LAB_AGENT_MODEL_PRICING={}

# Stop policy: wall-clock ceiling (commented = unbounded), consecutive
# no-progress rounds, and the dispatch-attempt cap for known non-dispatched
# transient failures. Ambiguous provider outcomes are held for reconciliation.
# LAB_AGENT_WALL_TIME_BUDGET_SECONDS=3600
LAB_AGENT_NO_PROGRESS_ROUNDS=3
LAB_AGENT_MODEL_CALL_MAX_ATTEMPTS=3
