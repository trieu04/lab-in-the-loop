diff --git a/apps/canvus-serving/app/scanner/parser.py b/apps/canvus-serving/app/scanner/parser.py
index 4241af4..b0c82a8 100644
--- a/apps/canvus-serving/app/scanner/parser.py
+++ b/apps/canvus-serving/app/scanner/parser.py
@@ -8,6 +8,7 @@ import re
 from dataclasses import dataclass
 
 QUERY_PATTERN = re.compile(r"\{\{(.+?)\}\}", re.DOTALL)
+EXP_PATTERN = re.compile(r"\{exp:\s*(.+?)\}", re.DOTALL)
 ACTION_PATTERN = re.compile(
     r"^!canvus\s+action\s+(\w+)\s+(\{.*\}|\S+)",
     re.MULTILINE,
@@ -114,3 +115,21 @@ class CommandParser:
     def is_relevant(widget_type: str) -> bool:
         """Return True if widget type can contain commands."""
         return widget_type in ("Note", "Browser")
+
+    @staticmethod
+    def extract_exp(text: str) -> str | None:
+        """Return the chat content inside a ``{exp: ...}`` marker, or None.
+
+        Used only by the connector dispatcher so the experiment flow stays gated
+        on a RagCluster -> Note connector — it must NOT surface as a general
+        parse_widget command, or a bare ``{exp:}`` Note would fire without one.
+        """
+        if not text:
+            return None
+        match = EXP_PATTERN.search(text)
+        if not match:
+            return None
+        content = match.group(1).strip()
+        if not content or len(content) > MAX_QUERY_LENGTH:
+            return None
+        return content
